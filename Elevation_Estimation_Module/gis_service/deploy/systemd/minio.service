[Unit]
Description=MinIO object store for DepthWizard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=depthwizard
Group=depthwizard
EnvironmentFile=/etc/depthwizard/minio.env
ExecStart=/usr/local/bin/minio server /var/lib/depthwizard/minio --address 127.0.0.1:9000 --console-address 127.0.0.1:9001
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

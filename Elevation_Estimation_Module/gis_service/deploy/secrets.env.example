# Copy to deploy/secrets.env on the server (it is git-ignored) and fill in.
# gis_service reads it at start-up, before deploy/depthwizard.env.

# OpenTopography API key (reference DEM for the height-comparison feature).
OPENTOPOGRAPHY_API_KEY=

# MinIO object store (GLBs and raster exports). Must match the MinIO
# server's MINIO_ROOT_USER / MINIO_ROOT_PASSWORD (deploy/systemd/minio.env).
DEPTHWIZARD_MINIO_ENDPOINT=127.0.0.1:9000
DEPTHWIZARD_MINIO_ACCESS_KEY=
DEPTHWIZARD_MINIO_SECRET_KEY=

        );
    }


    // --------------------------------------------------------
    // Lighting
    // --------------------------------------------------------

    if (dom.lightingBtn) {
        dom.lightingBtn.addEventListener(
            'click',
            handleLightingClick
        );
    }

    if (dom.lightSlider) {
        dom.lightSlider.addEventListener(
            'input',

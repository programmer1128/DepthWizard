        );
    }

    if (dom.flyRouteBtn) {
        dom.flyRouteBtn.addEventListener(
            'click',
            handleFlyRouteClick
        );
    }


    // --------------------------------------------------------
    // Initial UI state
    // --------------------------------------------------------

    updateNavigationButtons();
    updateGridButton();

}

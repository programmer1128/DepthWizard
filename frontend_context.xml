} 
 
.btn-primary:hover:not(:disabled) { 
  transform: translateY(-1px); 
  box-shadow: 0 6px 20px rgba(56, 189, 248, 0.45); 
  filter: brightness(1.08); 
} 
 
.btn-primary:active:not(:disabled) { 
  transform: translateY(0); 
} 
 
.btn-primary:disabled { 
  opacity: 0.55; 
  cursor: not-allowed; 
  filter: grayscale(0.4); 
} 
 
.btn-secondary { 
  width: 100%; 
  margin-top: 6px; 
  padding: 8px 12px; 
  border: 1px solid var(--border-subtle); 
  border-radius: var(--radius-sm); 
  background: rgba(255, 255, 255, 0.03); 
  color: var(--text-secondary); 
  font-size: 11px; 
  font-weight: 600; 
  cursor: pointer; 
  transition: all 0.2s ease; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  gap: 6px; 
} 
 
.btn-secondary:hover { 
  background: var(--panel-card-hover); 
  color: var(--text-primary); 
  border-color: var(--border-light); 
} 
 
/* ============================================================ 
   CONTROL GRIDS & BUTTONS 
   ============================================================ */ 
.control-grid-2 { 
  display: grid; 
  grid-template-columns: 1fr 1fr; 
  gap: 8px; 
} 
 
.control-grid-3 { 
  display: grid; 
  grid-template-columns: 1fr 1fr 1fr; 
  gap: 6px; 
} 
 
.tool-btn { 
  padding: 10px 8px; 
  border: 1px solid var(--border-subtle); 
  border-radius: var(--radius-sm); 
  background: var(--panel-card); 
  color: var(--text-secondary); 
  font-size: 11px; 
  font-weight: 600; 
  cursor: pointer; 
  transition: all 0.2s ease; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  gap: 6px; 
  user-select: none; 
} 
 
.tool-btn:hover { 
  background: var(--panel-card-hover); 
  border-color: var(--border-light); 
  color: var(--text-primary); 
} 
 
.tool-btn.active { 
  border-color: var(--accent-cyan); 
  color: var(--accent-cyan); 
  background: rgba(56, 189, 248, 0.12); 
  box-shadow: 0 0 10px rgba(56, 189, 248, 0.2); 
} 
 
.tool-btn:disabled { 
  opacity: 0.5; 
  cursor: wait; 
  pointer-events: none; 
} 
 
/* Route Buttons */ 
.btn-route-draw.active { 
  border-color: #f43f5e; 
  color: #f43f5e; 
  background: rgba(244, 63, 94, 0.14); 
  box-shadow: 0 0 12px rgba(244, 63, 94, 0.25); 
  animation: pulse-border 2s infinite ease-in-out; 
} 
 
@keyframes pulse-border { 
  0%, 100% { border-color: rgba(244, 63, 94, 0.6); } 
  50% { border-color: rgba(244, 63, 94, 1); box-shadow: 0 0 16px rgba(244, 63, 94, 0.4); } 
} 
 
.btn-route-fly { 
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(56, 189, 248, 0.2)); 
  border-color: rgba(99, 102, 241, 0.4); 
  color: #a5b4fc; 
} 
 
.btn-route-fly:hover { 
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.35), rgba(56, 189, 248, 0.35)); 
  color: #fff; 
  border-color: #818cf8; 
} 
 
.btn-route-fly.flying { 
  background: rgba(245, 158, 11, 0.2); 
  border-color: var(--warning); 
  color: var(--warning); 
} 
 
.route-stats-card { 
  margin-top: 8px; 
  padding: 10px 12px; 
  background: rgba(10, 12, 18, 0.5); 
  border: 1px solid var(--border-subtle); 
  border-radius: var(--radius-sm); 
  display: flex; 
  flex-direction: column; 
  gap: 6px; 
} 
 
.route-stat-row { 
  display: flex; 
  align-items: center; 
  justify-content: space-between; 
  font-size: 11px; 
} 
 
.route-stat-label { 
  color: var(--text-muted); 
} 
 
.route-stat-value { 
  color: var(--text-primary); 
  font-family: var(--font-mono); 
  font-weight: 600; 
} 
 
/* ============================================================ 
   2D VS 3D COMPARISON CONTROLS 
   ============================================================ */ 
.comparison-card { 
  display: flex; 
  align-items: center; 
  justify-content: space-between; 
} 
 
.toggle-switch-wrapper { 
  display: flex; 
  align-items: center; 
  gap: 10px; 
} 
 
.switch { 
  position: relative; 
  display: inline-block; 
  width: 40px; 
  height: 22px; 
} 
 
.switch input { 
  opacity: 0; 
  width: 0; 
  height: 0; 
} 
 
.slider { 
  position: absolute; 
  cursor: pointer; 
  inset: 0; 
  background-color: #242938; 
  border: 1px solid var(--border-subtle); 
  transition: .25s ease; 
  border-radius: 20px; 
} 
 
.slider:before { 
  position: absolute; 
  content: ""; 
  height: 14px; 
  width: 14px; 
  left: 3px; 
  bottom: 3px; 
  background-color: var(--text-muted); 
  transition: .25s ease; 
  border-radius: 50%; 
} 
 
input:checked + .slider { 
  background-color: rgba(56, 189, 248, 0.25); 
  border-color: var(--accent-cyan); 
} 
 
input:checked + .slider:before { 
  transform: translateX(18px); 
  background-color: var(--accent-cyan); 
  box-shadow: 0 0 8px var(--accent-cyan); 
} 
 
/* ============================================================ 
   STATUS & TELEMETRY PANEL 
   ============================================================ */ 
.status-card { 
  display: flex; 
  flex-direction: column; 
  gap: 8px; 
} 
 
.status-indicator-row { 
  display: flex; 
  align-items: center; 
  gap: 10px; 
} 
 
.status-dot { 
  width: 9px; 
  height: 9px; 
  border-radius: 50%; 
  background: var(--text-muted); 
  position: relative; 
} 
 
.status-dot.ready { 
  background: var(--success); 
  box-shadow: var(--shadow-glow-green); 
  animation: pulse-green 2.2s infinite ease-in-out; 
} 
 
.status-dot.loading { 
  background: var(--warning); 
  box-shadow: 0 0 10px rgba(245, 158, 11, 0.5); 
  animation: pulse-warning 1.2s infinite ease-in-out; 
} 
 
.status-dot.error { 
  background: var(--danger); 
  box-shadow: 0 0 10px rgba(239, 68, 68, 0.6); 
} 
 
@keyframes pulse-green { 
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); } 
  70% { transform: scale(1.1); box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); } 
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); } 
} 
 
@keyframes pulse-warning { 
  0%, 100% { transform: scale(1); opacity: 0.8; } 
  50% { transform: scale(1.2); opacity: 1; } 
} 
 
.status-text-main { 
  font-size: 11px; 
  font-weight: 600; 
  color: var(--text-primary); 
  letter-spacing: 0.3px; 
} 
 
.status-sub { 
  font-size: 10px; 
  color: var(--text-muted); 
  line-height: 1.4; 
  padding-left: 19px; 
} 
 
/* ============================================================ 
   3D VIEWER CONTAINER & CANVASES 
   ============================================================ */ 
#viewer { 
  position: relative; 
  flex: 1; 
  min-width: 0; 
  min-height: 0; 
  background: linear-gradient(
    to bottom,
    #79bde8 0%,
    #b9ddf2 55%,
    #e8f3f8 100%
    );
  overflow: hidden; 
} 

#canvas-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
     background:
        linear-gradient(
            180deg,
            #87CEEB 0%,
            #BFE8F7 45%,
            #EAF7FA 100%
        );
    overflow: hidden;
}

#canvas-container canvas {
    display: block;
    width: 100%;
    height: 100%;
}
 
/* ============================================================ 
   EMPTY STATE OVERLAY (Canvas centered prompt) 
   ============================================================ */ 
#emptyStateOverlay { 
  position: absolute; 
  inset: 0; 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
  justify-content: center; 
  pointer-events: auto; 
  z-index: 15; 
  background: radial-gradient(circle at center, rgba(26, 26, 36, 0.65) 0%, rgba(12, 14, 20, 0.88) 75%); 
  transition: opacity 0.4s ease, visibility 0.4s ease; 
} 
 
#emptyStateOverlay.hidden { 
  opacity: 0; 
  visibility: hidden; 
  pointer-events: none; 
} 
 
.empty-state-card { 
  max-width: 440px; 
  padding: 32px 28px; 
  background: rgba(18, 22, 33, 0.85); 
  border: 1px solid rgba(255, 255, 255, 0.12); 
  border-radius: var(--radius-xl); 
  backdrop-filter: blur(18px); 
  text-align: center; 
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 30px rgba(56, 189, 248, 0.08); 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
} 
 
.empty-state-radar { 
  width: 72px; 
  height: 72px; 
  border-radius: 50%; 
  border: 1.5px solid rgba(56, 189, 248, 0.35); 
  background: radial-gradient(circle, rgba(56, 189, 248, 0.15) 0%, transparent 70%); 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  margin-bottom: 18px; 
  position: relative; 
  box-shadow: 0 0 25px rgba(56, 189, 248, 0.2); 
} 
 
.empty-state-radar::before { 
  content: ''; 
  position: absolute; 
  inset: 6px; 
  border-radius: 50%; 
  border: 1px dashed rgba(56, 189, 248, 0.3); 
  animation: radar-sweep 8s linear infinite; 
} 
 
@keyframes radar-sweep { 
  0% { transform: rotate(0deg); } 
  100% { transform: rotate(360deg); } 
} 
 
.empty-state-icon { 
  font-size: 28px; 
  color: var(--accent-cyan); 
} 
 
.empty-state-title { 
  font-size: 16px; 
  font-weight: 700; 
  color: var(--text-primary); 
  margin-bottom: 8px; 
  line-height: 1.3; 
} 
 
.empty-state-desc { 
  font-size: 12px; 
  color: var(--text-secondary); 
  line-height: 1.6; 
  margin-bottom: 22px; 
} 
 
.empty-state-actions { 
  display: flex; 
  gap: 10px; 
  width: 100%; 
} 
 
.empty-btn-upload { 
  flex: 1; 
  padding: 10px 16px; 
  border-radius: var(--radius-sm); 
  background: linear-gradient(135deg, var(--accent-cyan), var(--accent-blue)); 
  color: white; 
  font-size: 12px; 
  font-weight: 600; 
  border: none; 
  cursor: pointer; 
  transition: all 0.2s ease; 
} 
 
.empty-btn-upload:hover { 
  filter: brightness(1.1); 
  transform: translateY(-1px); 
} 
 
.empty-btn-demo { 
  flex: 1; 
  padding: 10px 16px; 
  border-radius: var(--radius-sm); 
  background: rgba(255, 255, 255, 0.08); 
  border: 1px solid var(--border-light); 
  color: var(--text-primary); 
  font-size: 12px; 
  font-weight: 600; 
  cursor: pointer; 
  transition: all 0.2s ease; 
} 
 
.empty-btn-demo:hover { 
  background: rgba(255, 255, 255, 0.15); 
  border-color: rgba(255, 255, 255, 0.25); 
  transform: translateY(-1px); 
} 
 
/* ============================================================ 
   PICTURE-IN-PICTURE (2D VS 3D OPTICAL COMPARISON) 
   ============================================================ */ 
#comparisonPiP { 
  position: absolute; 
  bottom: 24px; 
  right: 24px; 
  width: 280px; 
  background: rgba(14, 17, 26, 0.92); 
  border: 1px solid rgba(255, 255, 255, 0.15); 
  border-radius: var(--radius-lg); 
  backdrop-filter: blur(16px); 
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(0, 0, 0, 0.3); 
  z-index: 25; 
  overflow: hidden; 
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); 
} 
 
#comparisonPiP.hidden { 
  opacity: 0; 
  transform: translateY(20px) scale(0.95); 
  pointer-events: none; 
} 
 
#comparisonPiP.minimized { 
  width: 210px; 
} 
 
#comparisonPiP.minimized .pip-body { 
  display: none; 
} 
 
.pip-header { 
  padding: 10px 14px; 
  background: rgba(22, 27, 40, 0.85); 
  border-bottom: 1px solid var(--border-subtle); 
  display: flex; 
  align-items: center; 
  justify-content: space-between; 
} 
 
.pip-title-group { 
  display: flex; 
  align-items: center; 
  gap: 8px; 
} 
 
.pip-badge { 
  font-size: 9px; 
  font-weight: 700; 
  padding: 2px 6px; 
  border-radius: 4px; 
  background: rgba(56, 189, 248, 0.18); 
  color: var(--accent-cyan); 
  border: 1px solid rgba(56, 189, 248, 0.3); 
  text-transform: uppercase; 
} 
 
.pip-title { 
  font-size: 11px; 
  font-weight: 600; 
  color: var(--text-primary); 
} 
 
.pip-controls { 
  display: flex; 
  align-items: center; 
  gap: 4px; 
} 
 
.pip-btn { 
  width: 22px; 
  height: 22px; 
  border-radius: 4px; 
  background: transparent; 
  border: none; 
  color: var(--text-secondary); 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  font-size: 12px; 
  cursor: pointer; 
  transition: all 0.15s ease; 
} 
 
.pip-btn:hover { 
  background: rgba(255, 255, 255, 0.1); 
  color: #fff; 
} 
 
.pip-body { 
  position: relative; 
  width: 100%; 
  height: 180px; 
  background: #000; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  overflow: hidden; 
} 
 
#pipImage { 
  width: 100%; 
  height: 100%; 
  object-fit: cover; 
  transition: transform 0.3s ease; 
} 
 
#pipImage:hover { 
  transform: scale(1.05); 
} 
 
.pip-placeholder { 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
  justify-content: center; 
  gap: 6px; 
  padding: 20px; 
  color: var(--text-muted); 
  text-align: center; 
  font-size: 11px; 
} 
 
.pip-footer { 
  padding: 6px 12px; 
  background: rgba(10, 12, 18, 0.7); 
  display: flex; 
  align-items: center; 
  justify-content: space-between; 
  font-size: 10px; 
  color: var(--text-muted); 
  border-top: 1px solid var(--border-subtle); 
} 
 
/* ============================================================ 
   HUD OVERLAYS & TOOLBARS 
   ============================================================ */ 
.viewer-hud-status { 
  position: absolute; 
  top: 18px; 
  left: 18px; 
  display: flex; 
  align-items: center; 
  gap: 10px; 
  padding: 8px 14px; 
  background: rgba(14, 17, 26, 0.82); 
  border: 1px solid rgba(255, 255, 255, 0.1); 
  border-radius: var(--radius-md); 
  font-size: 11px; 
  color: var(--text-primary); 
  backdrop-filter: blur(12px); 
  z-index: 10; 
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3); 
} 
 
.mode-badge { 
  font-size: 9px; 
  font-weight: 700; 
  padding: 2px 6px; 
  border-radius: 4px; 
  background: rgba(255, 255, 255, 0.08); 
  color: var(--accent-cyan); 
  text-transform: uppercase; 
  letter-spacing: 0.5px; 
} 
 
#routeBanner { 
  position: absolute; 
  top: 18px; 
  left: 50%; 
  transform: translateX(-50%); 
  padding: 8px 18px; 
  background: rgba(244, 63, 94, 0.9); 
  border: 1px solid rgba(255, 255, 255, 0.3); 
  border-radius: 20px; 
  color: white; 
  font-size: 12px; 
  font-weight: 600; 
  box-shadow: 0 4px 20px rgba(244, 63, 94, 0.4); 
  z-index: 15; 
  display: none; 
  align-items: center; 
  gap: 8px; 
  animation: banner-pop 0.3s ease; 
} 
 
@keyframes banner-pop { 
  0% { transform: translate(-50%, -10px); opacity: 0; } 
  100% { transform: translate(-50%, 0); opacity: 1; } 
} 
 
#bottom-hud { 
  position: absolute; 
  left: 18px; 
  right: 18px; 
  bottom: 18px; 
  display: flex; 
  align-items: center; 
  justify-content: space-between; 
  pointer-events: none; 
  z-index: 10; 
} 
 
.hud-pill { 
  pointer-events: auto; 
  padding: 6px 12px; 
  border: 1px solid rgba(255, 255, 255, 0.08); 
  border-radius: var(--radius-sm); 
  background: rgba(12, 15, 23, 0.75); 
  color: var(--text-secondary); 
  font-size: 11px; 
  backdrop-filter: blur(8px); 
} 
 
/* ============================================================ 
   HELP MODAL 
   ============================================================ */ 
#help-panel { 
  display: none; 
  position: absolute; 
  top: 70px; 
  right: 24px; 
  width: 290px; 
  padding: 18px; 
  background: rgba(16, 20, 30, 0.96); 
  border: 1px solid var(--border-light); 
  border-radius: var(--radius-lg); 
  z-index: 40; 
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 30px rgba(0, 0, 0, 0.4); 
  backdrop-filter: blur(16px); 
} 
 
#help-panel.show { 
  display: block; 
  animation: fadeIn 0.2s ease; 
} 
 
@keyframes fadeIn { 
  from { opacity: 0; transform: translateY(-8px); } 
  to { opacity: 1; transform: translateY(0); } 
} 
 
.help-title { 
  margin-bottom: 12px; 
  font-size: 13px; 
  font-weight: 700; 
  color: var(--text-primary); 
  display: flex; 
  align-items: center; 
  justify-content: space-between; 
} 
 
.help-row { 
  display: flex; 
  align-items: center; 
  justify-content: space-between; 
  padding: 8px 0; 
  border-bottom: 1px solid rgba(255, 255, 255, 0.05); 
  color: var(--text-secondary); 
  font-size: 11px; 
} 
 
.help-row:last-child { 
  border-bottom: none; 
} 
 
.key-badge { 
  padding: 3px 7px; 
  border: 1px solid rgba(255, 255, 255, 0.15); 
  border-radius: 4px; 
  background: rgba(255, 255, 255, 0.06); 
  color: #fff; 
  font-family: var(--font-mono); 
  font-size: 10px; 
  font-weight: 600; 
} 
 
/* Spinner */ 
.spinner { 
  width: 14px; 
  height: 14px; 
  border: 2px solid rgba(255, 255, 255, 0.2); 
  border-top-color: var(--accent-cyan); 
  border-radius: 50%; 
  animation: spin 0.8s linear infinite; 
  display: inline-block; 
} 
 
@keyframes spin { 
  to { transform: rotate(360deg); } 
} 
 
/* ============================================================ 
   RESPONSIVE DESIGN 
   ============================================================ */ 
@media (max-width: 900px) { 
  :root { 
    --sidebar-width: 290px; 
  } 
  .top-center-telemetry { 
    display: none; 
  } 
  #comparisonPiP { 
    width: 220px; 
    bottom: 16px; 
    right: 16px; 
  } 
} 
style.css

/* ============================================================
   MERGED: POINT INSPECTOR / COMPASS / VISUALIZATION
   ============================================================ */
.visual-control { padding: 12px; }
.visual-control-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; font-size:11px; color:var(--text-primary); }
.mini-btn { padding:4px 9px; border:1px solid rgba(88,183,255,.35); border-radius:6px; background:rgba(88,183,255,.10); color:var(--accent-cyan); font-size:9px; font-weight:700; cursor:pointer; }
.slider-label { display:flex; justify-content:space-between; margin-bottom:7px; color:var(--text-muted); font-size:10px; }
#lightSlider { width:100%; accent-color:var(--accent-cyan); }
.coordinate-card { padding:10px 12px; }
.coordinate-row { display:flex; justify-content:space-between; padding:6px 0; border-bottom:1px solid var(--border-subtle); font-family:var(--font-mono); font-size:10px; }
.coordinate-row:last-child { border-bottom:none; }
.coordinate-label { color:var(--text-muted); }
.coordinate-value { color:var(--text-primary); }

#compass-control {
  position:absolute;
  top:76px;
  right:22px;
  width:58px;
  height:58px;
  border:1px solid rgba(255,255,255,.14);
  border-radius:50%;
  background:rgba(12,16,24,.72);
  backdrop-filter:blur(10px);
  z-index:24;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  box-shadow:0 8px 24px rgba(0,0,0,.35);
}
.compass-face { width:44px; height:44px; border:1px solid rgba(88,183,255,.25); border-radius:50%; position:relative; transition:transform .15s ease; }
.compass-north { position:absolute; top:3px; left:50%; transform:translateX(-50%); font:700 9px var(--font-mono); color:var(--accent-cyan); }
.compass-arrow { position:absolute; left:50%; top:13px; width:2px; height:18px; transform:translateX(-50%); background:var(--accent-cyan); box-shadow:0 0 8px rgba(88,183,255,.55); }
.compass-arrow::before { content:''; position:absolute; top:-5px; left:-4px; border-left:5px solid transparent; border-right:5px solid transparent; border-bottom:8px solid var(--accent-cyan); }

#inspector-overlay {
  position:absolute;
  top:76px;
  left:20px;
  min-width:180px;
  padding:12px 14px;
  background:rgba(12,16,24,.84);
  border:1px solid var(--border-light);
  border-radius:var(--radius-md);
  backdrop-filter:blur(12px);
  z-index:24;
  box-shadow:0 12px 30px rgba(0,0,0,.35);
}
.inspector-title { font-size:10px; font-weight:700; color:var(--text-secondary); text-transform:uppercase; letter-spacing:1px; margin-bottom:7px; }
#inspector-content { color:var(--text-muted); font-size:10px; line-height:1.6; }
.inspector-coordinates { display:grid; gap:3px; }
.inspector-coordinates div { display:flex; justify-content:space-between; gap:20px; }
.inspector-coordinates span { color:var(--text-muted); }
.inspector-coordinates strong { color:var(--text-primary); font-family:var(--font-mono); }

@media (max-width: 900px) {
  :root { --sidebar-width:290px; }
  #compass-control { right:12px; top:70px; }
  #inspector-overlay { left:12px; top:70px; }
}

/* ============================================================
   TERRAIN HEIGHT CARD
   ============================================================ */

#terrain-height-card {
    position: fixed;
    z-index: 1000;

    min-width: 190px;

    background: rgba(20, 29, 45, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.15);

    border-radius: 12px;

    box-shadow:
        0 12px 35px rgba(0, 0, 0, 0.3);

    color: white;

    opacity: 0;
    pointer-events: none;

    transform: translateY(6px);

    transition:
        opacity 0.15s ease,
        transform 0.15s ease;
}

#terrain-height-card.visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
}

.height-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 10px 12px;

    border-bottom:
        1px solid rgba(255, 255, 255, 0.1);

    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

#height-card-close {
    border: none;
    background: transparent;
    color: white;

    font-size: 20px;
    cursor: pointer;
}

.height-card-body {
    padding: 14px;
}

.height-card-label {
    font-size: 9px;
    opacity: 0.6;
    letter-spacing: 0.1em;
}

.height-card-value {
    margin-top: 4px;

    font-size: 25px;
    font-weight: 700;
}

.height-card-position {
    margin-top: 7px;

    font-size: 10px;
    opacity: 0.65;
}


/* ============================================================
   COMPARE MODAL
   ============================================================ */

#compare-modal {
    position: fixed;
    inset: 0;

    z-index: 2000;

    display: flex;
    align-items: center;
    justify-content: center;

    visibility: hidden;
    opacity: 0;

    transition:
        opacity 0.2s ease,
        visibility 0.2s ease;
}

#compare-modal.visible {
    visibility: visible;
    opacity: 1;
}

.compare-modal-backdrop {
    position: absolute;
    inset: 0;

    background:
        rgba(10, 15, 25, 0.68);

    backdrop-filter: blur(5px);
}

.compare-modal-card {
    position: relative;

    width: min(760px, calc(100vw - 40px));

    background: #fffdf8;
    color: #1e2a44;

    border-radius: 18px;

    box-shadow:
        0 30px 80px rgba(0, 0, 0, 0.35);

    overflow: hidden;
}

.compare-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;

    padding: 25px 28px 20px;

    border-bottom:
        1px solid rgba(30, 42, 68, 0.1);
}

.compare-modal-kicker,
.inspection-kicker {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.14em;
    opacity: 0.55;
}

.compare-modal-header h2,
.inspection-card-header h2 {
    margin: 5px 0 0;

    font-size: 23px;
}

.compare-close-btn,
.inspection-close-btn {
    width: 32px;
    height: 32px;

    border: none;
    border-radius: 8px;

    background: rgba(30, 42, 68, 0.08);

    color: #1e2a44;

    font-size: 21px;

    cursor: pointer;
}

.compare-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
}

.compare-option {
    padding: 25px 28px;

    min-height: 220px;
}

.compare-option + .compare-option {
    border-left:
        1px solid rgba(30, 42, 68, 0.1);
}

.compare-option-number {
    font-size: 10px;
    font-weight: 800;
    opacity: 0.45;
}

.compare-option h3 {
    margin: 12px 0 7px;

    font-size: 17px;
}

.compare-option p {
    margin: 0 0 20px;

    font-size: 12px;
    line-height: 1.5;

    opacity: 0.65;
}

.compare-upload-box {
    display: flex;
    justify-content: space-between;
    align-items: center;

    gap: 10px;

    padding: 13px;

    border: 1px dashed rgba(30, 42, 68, 0.3);
    border-radius: 10px;

    cursor: pointer;

    font-size: 11px;
}

.compare-upload-box span:last-child {
    font-weight: 700;
}

.compare-dataset-select {
    width: 100%;

    padding: 13px;

    border-radius: 10px;

    border:
        1px solid rgba(30, 42, 68, 0.18);

    background: white;

    color: #1e2a44;

    outline: none;
}

.compare-modal-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 18px 28px;

    border-top:
        1px solid rgba(30, 42, 68, 0.1);
}

.compare-progress {
    font-size: 11px;
    opacity: 0.6;
}

.compare-get-btn,
.inspection-done-btn {
    border: none;

    padding: 11px 25px;

    border-radius: 9px;

    background: #1e2a44;
    color: white;

    font-weight: 800;
    font-size: 11px;

    cursor: pointer;
}

.compare-get-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
}

/* ============================================================
   DEPTHWIZARD
   INSPECTION RESULTS - SIDE PANEL
   ============================================================ */

#inspection-card {
    position: fixed !important;

    top: 130px !important;
    right: 24px !important;

    width: 360px !important;
    max-width: calc(100vw - 48px) !important;

    height: auto !important;
    max-height: calc(100vh - 160px) !important;

    overflow-y: auto !important;

    display: none;

    box-sizing: border-box !important;

    padding: 0 !important;

    border-radius: 16px !important;

    z-index: 5000 !important;

    background: #172131 !important;

    color: #ffffff !important;

    box-shadow:
        0 20px 50px rgba(0, 0, 0, 0.35) !important;

    border: 1px solid rgba(255, 255, 255, 0.10) !important;
}

#inspection-card.visible {
    display: block !important;
}


/* HEADER */

#inspection-card .inspection-card-header {
    display: flex !important;

    justify-content: space-between !important;
    align-items: flex-start !important;

    padding: 18px 18px 14px !important;

    border-bottom:
        1px solid rgba(255, 255, 255, 0.08) !important;
}

#inspection-card .inspection-kicker {
    font-size: 10px !important;

    letter-spacing: 1.4px !important;

    font-weight: 700 !important;

    color: #4fc3f7 !important;
}

#inspection-card .inspection-card-header h2 {
    margin: 5px 0 0 !important;

    font-size: 20px !important;

    line-height: 1.2 !important;

    color: #ffffff !important;
}


/* CLOSE X */

#inspection-card .inspection-close-btn {
    width: 32px !important;
    height: 32px !important;

    padding: 0 !important;

    border: none !important;

    border-radius: 8px !important;

    background:
        rgba(255, 255, 255, 0.08) !important;

    color: #ffffff !important;

    font-size: 20px !important;

    cursor: pointer !important;
}


/* DATASET */

#inspection-card .inspection-dataset {
    padding: 12px 18px !important;

    font-size: 12px !important;

    color:
        rgba(255, 255, 255, 0.55) !important;
}

#inspection-card .inspection-dataset strong {
    color: #ffffff !important;
}


/* METRICS */

#inspection-card .inspection-metrics {
    display: grid !important;

    grid-template-columns: 1fr 1fr !important;

    gap: 9px !important;

    padding: 4px 18px 16px !important;
}

#inspection-card .inspection-metric {
    min-width: 0 !important;

    padding: 12px !important;

    border-radius: 10px !important;

    background:
        rgba(255, 255, 255, 0.055) !important;

    border:
        1px solid rgba(255, 255, 255, 0.07) !important;
}

#inspection-card .inspection-metric-label {
    display: block !important;

    margin-bottom: 7px !important;

    font-size: 10px !important;

    line-height: 1.3 !important;

    color:
        rgba(255, 255, 255, 0.52) !important;
}

#inspection-card .inspection-metric-value {
    display: block !important;

    font-size: 17px !important;

    font-weight: 700 !important;

    color: #ffffff !important;
}


/* CLOSE BUTTON */

#inspection-card .inspection-done-btn {
    width: calc(100% - 36px) !important;

    margin: 0 18px 18px !important;

    padding: 11px !important;

    border: none !important;

    border-radius: 9px !important;

    background:
        rgba(255, 255, 255, 0.10) !important;

    color: #ffffff !important;

    font-weight: 700 !important;

    cursor: pointer !important;
}

#inspection-card .inspection-done-btn:hover {
    background:
        rgba(255, 255, 255, 0.16) !important;
}


/* MOBILE */

@media (max-width: 700px) {

    #inspection-card {

        top: auto !important;

        right: 12px !important;

        bottom: 12px !important;

        width: calc(100vw - 24px) !important;

        max-width: none !important;

        max-height: 70vh !important;
    }
}

/* ============================================================
   IMAGE TYPE SELECTOR (GEOTIFF vs NORMAL IMAGE)
   ============================================================ */

.image-type-toggle {
    display: flex;
    gap: 6px;
    margin-bottom: 10px;
    padding: 3px;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
}

.type-tab-btn {
    flex: 1;
    padding: 7px 10px;
    border-radius: 7px;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.6);
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: center;
}

.type-tab-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
}

.type-tab-btn.active {
    background: #4fc3f7;
    color: #0b1523;
    font-weight: 800;
    box-shadow: 0 2px 8px rgba(79, 195, 247, 0.3);
}


.height-card-actions {
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.height-card-action-btn {
    width: 100%;
    padding: 6px 10px;
    border-radius: 6px;
    border: 1px solid rgba(79, 195, 247, 0.35);
    background: rgba(79, 195, 247, 0.12);
    color: #4fc3f7;
    font-size: 10.5px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
}

.height-card-action-btn:hover {
    background: rgba(79, 195, 247, 0.22);
    border-color: #4fc3f7;
}

/* ============================================================
   COMPARE MODAL FORM INPUTS
   ============================================================ */

.compare-field-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.compare-input-label {
    font-size: 11px;
    font-weight: 700;
    color: #1e2a44;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.compare-text-input {
    width: 100%;
    box-sizing: border-box;
    padding: 11px 13px;
    border-radius: 10px;
    border: 1px solid rgba(30, 42, 68, 0.2);
    background: white;
    color: #1e2a44;
    font-size: 12.5px;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.compare-text-input:focus {
    border-color: #1e2a44;
    box-shadow: 0 0 0 3px rgba(30, 42, 68, 0.08);
}

.compare-input-hint {
    font-size: 10.5px;
    color: rgba(30, 42, 68, 0.55);
    line-height: 1.35;
}

.compare-coord-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.compare-coord-actions {
    display: flex;
    gap: 8px;
    margin-top: 10px;
}

.compare-secondary-btn {
    flex: 1;
    padding: 7px 10px;
    border-radius: 7px;
    border: 1px solid rgba(30, 42, 68, 0.2);
    background: rgba(30, 42, 68, 0.05);
    color: #1e2a44;
    font-size: 10.5px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease;
}

.compare-secondary-btn:hover {
    background: rgba(30, 42, 68, 0.12);
}

/* ============================================================
   INSPECTION CARD & DIFF MAP VISUALIZATION
   ============================================================ */

.inspection-query-details {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-top: 5px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.65);
}

.inspection-elevation-summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
    gap: 8px;
    padding: 0 18px 12px;
}

.inspection-summary-col {
    padding: 9px 10px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.summary-label {
    font-size: 9.5px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
}

.summary-value {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
}

.summary-value.highlight {
    color: #4fc3f7;
}

.inspection-diff-map-card {
    margin: 0 18px 16px;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.12);
}

.diff-map-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px;
    background: rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.diff-map-label {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #4fc3f7;
}

.diff-pip-action-btn {
    padding: 4px 9px;
    border-radius: 5px;
    border: 1px solid rgba(79, 195, 247, 0.4);
    background: rgba(79, 195, 247, 0.15);
    color: #4fc3f7;
    font-size: 10px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease;
}

.diff-pip-action-btn:hover {
    background: rgba(79, 195, 247, 0.28);
}

.diff-map-preview-wrap {
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0d1420;
    min-height: 120px;
}

.diff-map-image {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    display: block;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
}

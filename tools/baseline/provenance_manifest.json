{
  "schema": "depthwizard.baseline.provenance.v1",
  "rule": "Runtime reconstruction may use only the uploaded image, its metadata, the permitted low-resolution DEM path and learned models. No human-mapped building or map data (OSM, cadastre, CityGML, Google/Mapbox/Cesium buildings, LiDAR) may enter inference.",
  "allowed_hosts": [
    {"pattern": "satadru-ghosh-cse28--depth-wizard-inference-*.modal.run", "role": "nDSM depth model inference on uploaded image tiles", "phase": "runtime", "data": "model"},
    {"pattern": "satadru-ghosh-cse28--depth-wizard-semantic-inference-*.modal.run", "role": "semantic segmentation inference on uploaded image tiles", "phase": "runtime", "data": "model"},
    {"pattern": "programmer1128--sat2lod2-reconstruction-*.modal.run", "role": "SAT2LoD2 footprint decomposition of backend-derived rasters (OSM step disabled)", "phase": "runtime", "data": "algorithm"},
    {"pattern": "elevation-tiles-prod.s3.amazonaws.com", "role": "low-resolution terrain base DEM (permitted DEM path)", "phase": "runtime", "data": "low_resolution_dem"},
    {"pattern": "copernicus-dem-30m.s3.eu-central-1.amazonaws.com", "role": "low-resolution terrain base DEM (permitted DEM path; currently unused code)", "phase": "runtime", "data": "low_resolution_dem"},
    {"pattern": "portal.opentopography.org", "role": "reference DEM for /api/height/compare only; never enters reconstruction", "phase": "validation", "data": "reference_dem"},
    {"pattern": "bhuvan-vec1.nrsc.gov.in", "role": "reference DEM for /api/height/compare only; never enters reconstruction", "phase": "validation", "data": "reference_dem"},
    {"pattern": "cdn.jsdelivr.net", "role": "frontend library code (geotiff.js); no geodata, but breaks offline standalone use", "phase": "frontend_asset", "data": "library"},
    {"pattern": "fonts.googleapis.com", "role": "frontend web fonts; no geodata, but breaks offline standalone use", "phase": "frontend_asset", "data": "font"},
    {"pattern": "download.pytorch.org", "role": "Modal image build (PyTorch wheels)", "phase": "build", "data": "package"},
    {"pattern": "github.com", "role": "source/documentation references and image-build clones", "phase": "build", "data": "code"},
    {"pattern": "registry.khronos.org", "role": "documentation reference", "phase": "documentation", "data": "none"},
    {"pattern": "www.w3.org", "role": "XML/SVG namespace identifiers", "phase": "documentation", "data": "none"},
    {"pattern": "modal.com", "role": "documentation reference", "phase": "documentation", "data": "none"},
    {"pattern": "user--app.modal.run", "role": "placeholder in tests and comments", "phase": "documentation", "data": "none"},
    {"pattern": "host", "role": "placeholder in comments", "phase": "documentation", "data": "none"},
    {"pattern": "localhost", "role": "local services", "phase": "runtime", "data": "local"},
    {"pattern": "127.0.0.1", "role": "local services (backend, MinIO, local SAT2LoD2)", "phase": "runtime", "data": "local"},
    {"pattern": "0.0.0.0", "role": "listener address", "phase": "runtime", "data": "local"},
    {"pattern": "103.135.230.65", "role": "team deployment server (frontend API base)", "phase": "runtime", "data": "local"}
  ],
  "forbidden_substrings": [
    "openstreetmap", "overpass", "osm.org", "nominatim", "mapbox", "maps.googleapis", "tile.googleapis",
    "googleapis.com/tile", "photorealistic", "cesium.com", "ion.cesium", "arcgisonline", "arcgis.com",
    "virtualearth", "bing.com/maps", "here.com", "overturemaps", "minedbuildings",
    "globalmlbuildingfootprints", "citygml", "cadastr", "opentopography.org/lidar"
  ]
}

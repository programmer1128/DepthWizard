# DepthWizard frontend build/dev settings (copy to .env.local if needed).

# Backend the Vite dev/preview server forwards /api to (development only).
DEPTHWIZARD_BACKEND_URL=http://127.0.0.1:8081

# Leave unset for same-origin deployments (NGINX proxies /api). Set it only
# when the backend is on a different origin; that origin must then be listed
# in the backend's DEPTHWIZARD_CORS_ORIGINS.
# VITE_API_BASE=http://my-backend-host:8081

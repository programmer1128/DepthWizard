TEST(SemanticPostProcessorTest, RejectsMismatchedRasterShapeAndClassContract)
{
    SemanticLogits logits =
        makeLogits(4, 4, {2.0F, 0.0F, 0.0F, 0.0F, 0.0F, 0.0F});
    logits.buildingLogits.width = 3;

            std::vector<uint8_t>(16, 1),
            {1.0F, 2.0F, 3.0F, 4.0F, 5.0F, 6.0F}));

    payload.allTiles.push_back(
        makeTile(
            2,
            0,
            0,
            4,
            4,
            std::vector<float>(16, 20.0F),

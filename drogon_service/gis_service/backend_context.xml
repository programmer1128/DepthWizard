    auto ndsm = makeConstantGrid(44, 18, 0.0F);
    auto valid = makeConstantGrid<uint8_t>(44, 18, uint8_t{1});
    std::vector<DecomposedBuildingBlock> blocks;
    for (int left : {2, 22})

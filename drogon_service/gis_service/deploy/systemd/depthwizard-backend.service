[Unit]
Description=DepthWizard backend (gis_service)
After=network-online.target minio.service
Wants=network-online.target minio.service

[Service]
Type=simple
User=depthwizard
Group=depthwizard
# Checkout of the backend branch; the build directory holds the binary,
# deploy/ (settings) sits next to it.
WorkingDirectory=/opt/depthwizard/backend/drogon_service/gis_service/build-release
ExecStart=/opt/depthwizard/backend/drogon_service/gis_service/build-release/gis_service
Restart=on-failure
RestartSec=5
# Long reconstructions; give jobs time to finish on stop.
TimeoutStopSec=60
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

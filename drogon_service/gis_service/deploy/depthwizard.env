# DepthWizard backend settings: the configuration validated on the urban
# (NYC, Washington), natural terrain (Test8), sparse (sparse_desert, Sparse,
# sparse2) and forest (forest3) test scenes.
#
# gis_service reads this file at start-up (deploy/ next to its build
# directory), so `./gis_service` needs no exports. Anything already in the
# environment wins: `export DEPTHWIZARD_X=...` before starting, a systemd
# Environment= line, or deploy/secrets.env (credentials, not in git).

# --- Server -------------------------------------------------------------
# 127.0.0.1: only NGINX (production) or the Vite dev proxy (development)
# reach the backend. Use 0.0.0.0 only if browsers must call it directly.
DEPTHWIZARD_LISTEN_ADDRESS=127.0.0.1
DEPTHWIZARD_PORT=8081
DEPTHWIZARD_LOG_LEVEL=INFO
# Browser origins allowed to call the API directly (not needed behind NGINX
# or the Vite proxy, which are same-origin).
DEPTHWIZARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Scene presentation and buildings ----------------------------------
DEPTHWIZARD_PRESENTATION=auto
DEPTHWIZARD_PRESENTATION_STYLE=orthophoto
DEPTHWIZARD_SAT2LOD2=1
DEPTHWIZARD_CITY3D=0
DEPTHWIZARD_SAM2=0
DEPTHWIZARD_KIBS=0
DEPTHWIZARD_HYBRID_FUSION=0

# --- Vegetation -----------------------------------------------------------
# Canopy, trees, bushes, garden shrubs and forest trees (bundled CC-BY assets).
DEPTHWIZARD_VEGETATION=1
DEPTHWIZARD_VEGETATION_ASSET_MODE=external
DEPTHWIZARD_VEGETATION_FOREST_PROXIES=1

# --- Diagnostics ------------------------------------------------------------
# Per-job debug rasters/GLBs under reconstruction_diagnostics/. They do not
# change results; set to 1 when investigating a scene.
DEPTHWIZARD_DIAGNOSTICS=0
DEPTHWIZARD_VEGETATION_DIAGNOSTICS=0

# --- Global map (bounding-box imagery) -----------------------------------
# Sentinel-2 L2A from the public Earth Search catalogue (no credentials).
DEPTHWIZARD_GLOBAL_MAP_MAX_AGE_DAYS=730
DEPTHWIZARD_GLOBAL_MAP_MAX_SCENES=6

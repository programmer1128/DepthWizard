{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:depthwizard:contracts:roofgraph:v1",
  "title": "DepthWizard RoofGraph Contract v1",
  "description": "Proposal geometry exchanged between the DepthWizard backend and the SAM2/KIBS services. Coordinates are (column, row) pixel edges. No field carries an authoritative height. Geometric rules (simple rings, winding, holes inside their outer ring, raster bounds, unique ids, adjacency) are enforced by the C++ importer and the Pydantic models; see README.md.",
  "type": "object",
  "required": [
    "schema",
    "raster_width",
    "raster_height",
    "coordinate_convention",
    "buildings"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "depthwizard.roofgraph.v1",
      "description": "Fixed schema identifier"
    },
    "raster_width": {
      "type": "integer",
      "minimum": 1,
      "description": "Raster extent width in pixels"
    },
    "raster_height": {
      "type": "integer",
      "minimum": 1,
      "description": "Raster extent height in pixels"
    },
    "coordinate_convention": {
      "type": "string",
      "description": "The only supported convention: (0, 0) is the top-left raster corner and (W, H) the bottom-right corner. Coordinates are never shifted by half a pixel.",
      "const": "pixel_edge_column_row"
    },
    "metadata": {
      "type": "object",
      "description": "Optional scene-level spatial or projection metadata",
      "properties": {
        "scene_id": {
          "type": "string"
        },
        "crs": {
          "type": "string"
        },
        "geo_transform": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 6,
          "maxItems": 6
        },
        "gsd": {
          "type": "number",
          "exclusiveMinimum": 0.0
        }
      },
      "additionalProperties": true
    },
    "buildings": {
      "type": "array",
      "description": "Collection of candidate building instances",
      "items": {
        "$ref": "#/$defs/building_proposal"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "point2d": {
      "type": "array",
      "description": "2D coordinate [column, row]",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "ring": {
      "type": "array",
      "description": "Open ring (no repeated closing vertex) of at least 3 distinct vertices, at most 10000.",
      "items": {
        "$ref": "#/$defs/point2d"
      },
      "minItems": 3,
      "maxItems": 10000
    },
    "scores": {
      "type": "object",
      "description": "Confidence and quality metrics in range [0, 1]",
      "properties": {
        "semantic": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.0
        },
        "ndsm": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.0
        },
        "sam2": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Absent or null when the expert did not run."
        },
        "kibs": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Absent or null when the expert did not run."
        },
        "combined": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Absent or null when the expert did not run."
        }
      },
      "additionalProperties": true
    },
    "corner_hint": {
      "type": "object",
      "required": [
        "xy"
      ],
      "properties": {
        "xy": {
          "$ref": "#/$defs/point2d"
        },
        "height_class_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.0,
          "description": "Advisory KIBS height class in metres. A hint only: the backend's corrected nDSM is the sole height authority."
        },
        "score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.0
        },
        "corner_type": {
          "type": "string",
          "description": "Advisory corner classification, e.g. eave_corner, ridge_end, step",
          "default": "unknown"
        }
      },
      "additionalProperties": true
    },
    "roof_section": {
      "type": "object",
      "required": [
        "id",
        "polygon"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique across the whole document."
        },
        "polygon": {
          "$ref": "#/$defs/ring"
        },
        "holes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ring"
          },
          "default": []
        },
        "corners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/corner_hint"
          },
          "default": []
        },
        "type_hint": {
          "type": "string",
          "default": "unknown",
          "description": "Roof type hint, e.g. flat, gable, hip, shed, pyramid, complex, unknown"
        },
        "adjacent_sections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "description": "IDs of other sections of the same building."
        },
        "score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.0
        }
      },
      "additionalProperties": true
    },
    "provenance_entry": {
      "type": "object",
      "required": [
        "stage",
        "source"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "description": "Pipeline stage producing or modifying this geometry (e.g. semantic_detection, sam2_refinement, kibs_decomposition, native_fallback)",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "description": "Model or module identifier (e.g. sam2.1-hiera-large, kibs-resnet50, native-ndsm)",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 UTC timestamp"
        },
        "details": {
          "description": "Optional arbitrary stage parameters, prompts, bounding boxes, or timings"
        }
      },
      "additionalProperties": true
    },
    "building_proposal": {
      "type": "object",
      "required": [
        "id",
        "footprint_proposal"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique building identifier within the document."
        },
        "footprint_proposal": {
          "$ref": "#/$defs/ring",
          "description": "Ground footprint proposal outer boundary in image coordinates"
        },
        "roofprint_proposal": {
          "description": "Visible roof outline. Absent, null or empty when no roofprint was proposed.",
          "oneOf": [
            {
              "$ref": "#/$defs/ring"
            },
            {
              "type": "array",
              "maxItems": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "holes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ring"
          },
          "default": [],
          "description": "Courtyards of footprint_proposal; each lies strictly inside it."
        },
        "scores": {
          "$ref": "#/$defs/scores"
        },
        "roof_sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/roof_section"
          },
          "default": []
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance_entry"
          },
          "default": []
        }
      },
      "additionalProperties": true
    }
  }
}

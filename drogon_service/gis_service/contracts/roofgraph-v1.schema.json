{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://depthwizard.io/contracts/roofgraph-v1.schema.json",
  "title": "DepthWizard RoofGraph Contract v1",
  "description": "Canonical hybrid geometry exchange format (depthwizard.roofgraph.v1) connecting Drogon C++ GIS backend, SAM 2.1 boundary refinement, and KIBS roof decomposition.",
  "type": "object",
  "required": [
    "schema",
    "raster_width",
    "raster_height",
    "coordinate_convention",
    "buildings"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "depthwizard.roofgraph.v1",
      "description": "Fixed schema identifier"
    },
    "raster_width": {
      "type": "integer",
      "minimum": 1,
      "description": "Raster extent width in pixels"
    },
    "raster_height": {
      "type": "integer",
      "minimum": 1,
      "description": "Raster extent height in pixels"
    },
    "coordinate_convention": {
      "type": "string",
      "enum": [
        "pixel_edge_column_row",
        "pixel_centre_column_row"
      ],
      "default": "pixel_edge_column_row",
      "description": "Explicit coordinate frame: pixel_edge_column_row maps (0,0) to raster top-left edge, while pixel_centre_column_row refers to pixel centers."
    },
    "metadata": {
      "type": "object",
      "description": "Optional scene-level spatial or projection metadata",
      "properties": {
        "scene_id": { "type": "string" },
        "crs": { "type": "string" },
        "geo_transform": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 6,
          "maxItems": 6
        },
        "gsd": { "type": "number", "minimum": 0.0 }
      },
      "additionalProperties": true
    },
    "buildings": {
      "type": "array",
      "description": "Collection of candidate building instances",
      "items": {
        "$ref": "#/$defs/building_proposal"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "point2d": {
      "type": "array",
      "description": "2D coordinate [column, row]",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "ring": {
      "type": "array",
      "description": "Open polygon ring of at least 3 unique vertices (no implicit closing vertex).",
      "items": {
        "$ref": "#/$defs/point2d"
      },
      "minItems": 3
    },
    "scores": {
      "type": "object",
      "description": "Confidence and quality metrics in range [0, 1]",
      "properties": {
        "semantic": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.0
        },
        "ndsm": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.0
        },
        "sam2": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.0
        },
        "kibs": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.0
        },
        "combined": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "additionalProperties": true
    },
    "corner_hint": {
      "type": "object",
      "required": ["xy"],
      "properties": {
        "xy": {
          "$ref": "#/$defs/point2d"
        },
        "height_class_m": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "description": "Advisory height class in metres from KIBS prior (non-authoritative; GAMUS nDSM remains height authority)."
        },
        "score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.0
        },
        "corner_type": {
          "type": "string",
          "description": "Advisory corner classification, e.g. eave_corner, ridge_end, step"
        }
      },
      "additionalProperties": true
    },
    "roof_section": {
      "type": "object",
      "required": ["id", "polygon"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier for this roof section within the building"
        },
        "polygon": {
          "$ref": "#/$defs/ring"
        },
        "holes": {
          "type": "array",
          "items": { "$ref": "#/$defs/ring" },
          "default": []
        },
        "corners": {
          "type": "array",
          "items": { "$ref": "#/$defs/corner_hint" },
          "default": []
        },
        "type_hint": {
          "type": "string",
          "default": "unknown",
          "description": "Roof type hint, e.g. flat, gable, hip, shed, pyramid, complex, unknown"
        },
        "adjacent_sections": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "IDs of adjacent roof sections"
        },
        "score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.0
        }
      },
      "additionalProperties": true
    },
    "provenance_entry": {
      "type": "object",
      "required": ["stage", "source"],
      "properties": {
        "stage": {
          "type": "string",
          "description": "Pipeline stage producing or modifying this geometry (e.g. semantic_detection, sam2_refinement, kibs_decomposition, native_fallback)"
        },
        "source": {
          "type": "string",
          "description": "Model or module identifier (e.g. sam2.1-hiera-large, kibs-resnet50, native-ndsm)"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 UTC timestamp"
        },
        "details": {
          "description": "Optional arbitrary stage parameters, prompts, bounding boxes, or timings"
        }
      },
      "additionalProperties": true
    },
    "building_proposal": {
      "type": "object",
      "required": ["id", "footprint_proposal"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique building instance identifier"
        },
        "footprint_proposal": {
          "$ref": "#/$defs/ring",
          "description": "Ground footprint proposal outer boundary in image coordinates"
        },
        "roofprint_proposal": {
          "description": "Roof boundary proposal; if omitted or empty, matches footprint_proposal",
          "oneOf": [
            { "$ref": "#/$defs/ring" },
            { "type": "array", "maxItems": 0 },
            { "type": "null" }
          ]
        },
        "holes": {
          "type": "array",
          "items": { "$ref": "#/$defs/ring" },
          "default": [],
          "description": "Inner courtyards / cutouts"
        },
        "scores": {
          "$ref": "#/$defs/scores"
        },
        "roof_sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/roof_section" },
          "default": []
        },
        "provenance": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/provenance_entry" },
              { "type": "string" }
            ]
          },
          "default": []
        }
      },
      "additionalProperties": true
    }
  }
}
